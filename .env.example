# Calliopa configuration. install.sh copies this file to .env on first run
# and adds any missing keys on re-run without touching your values.

# Host address the stack binds to. 127.0.0.1 keeps everything local-only.
CALLIOPA_HOST_BIND=127.0.0.1

# The only secret you supply yourself: the model-routing API key. Everything
# else (database password, object-store credentials) is generated on first
# run and stored inside the stack. Without this key the stack runs, but
# Hermes and embedding-based search stay inactive.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=

# Database identity. The password is generated on first run.
POSTGRES_DB=calliopa
POSTGRES_USER=calliopa

# Scheduled backups to the built-in object store.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
GARAGE_BACKUP_BUCKET=calliopa-backups

# Content-addressed binary Block content, served only through CCGW's blob
# routes. The staging TTL bounds how long an uploaded-but-unreferenced blob
# survives before GC collects it.
GARAGE_CONTENT_BUCKET=calliopa-content
BLOB_MAX_BYTES=104857600
BLOB_STAGING_TTL_SECONDS=604800
BLOB_GC_INTERVAL_SECONDS=86400

# The agent's memory database, beside the graph's. Created on first run;
# backed up with it. The shell keeps no database or bucket of its own.
CALLIOPA_MEMORY_DB=honcho

# The name stamped as provenance on what the kernel writes for you.
CALLIOPA_KERNEL_PRINCIPAL=human:operator
# The one owning human (BO_0206): the account the CLI and the kernel act as,
# named once at first boot and immutable after — it is the createdBy stamp.
# It is the name the browser shows when it asks you to choose the owner's
# password on your first visit; change it before the first install, not after.
CALLIOPA_OWNER_PRINCIPAL=owner
# The agent accounts, comma-separated: the CLI's agent identity from this
# host and the Hermes principal the kernel's toolset binds per run.
CALLIOPA_AGENT_PRINCIPALS=claude,agent:hermes

# Optional off-machine copy of the backup bucket (any S3-compatible target).
# Leave empty to skip. See https://www.calliopa.com.
RCLONE_CONFIG_OFFSITE_TYPE=
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_PATH=
OFFSITE_CONTENT_PATH=

# The release this install runs. The Calliopa binaries are downloaded from
# CALLIOPA_BINARY_SOURCE/v<version>/ when the images are built on your
# machine and checked against the release's SHA256SUMS, which is itself
# checked against the digest pinned here. Releases write these three lines;
# an air-gapped site points CALLIOPA_BINARY_SOURCE at any HTTP host holding
# the release's files. See https://www.calliopa.com for updating.
CALLIOPA_RELEASE_VERSION=0.3.2
CALLIOPA_BINARY_SOURCE=https://github.com/frankzickert/calliopa/releases/download
CALLIOPA_RELEASE_SHA256SUMS=ec3e7d62ee8b93f2679773eb34e340809d6f88c4bc4cb393cc5c97a1404d299c

# Images you pull from their publishers, pinned by digest. See THIRD-PARTY.md.
CALLIOPA_GARAGE_IMAGE=dxflrs/garage:v1.1.0@sha256:fdb8272fcbe643eef830ee17874d5d4ed623a86501f1acbac8012583113b1c26
CALLIOPA_HONCHO_IMAGE=ghcr.io/plastic-labs/honcho:v3.1.0@sha256:b73a8015f9e3ee51525e5b5cb238a915aa47de5107593d81b892213322fa369d
