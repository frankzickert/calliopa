% IEEE (BO_0293_020): IEEEtran in its conference form, two columns, the IEEE
% bibliography style — the citation style the bibliography already defaults
% to. A Pandoc LaTeX template, as the generic article is.
\documentclass[conference]{IEEEtran}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{amsmath,amssymb}
\usepackage{graphicx}
\usepackage{longtable,booktabs,array}
\usepackage[font=footnotesize]{caption}
\usepackage[numbers,sort&compress]{natbib}
\usepackage[hidelinks]{hyperref}
% Pandoc sets a code block in colour by itself: it writes \KeywordTok,
% \CommentTok and their kin, and these macros are what define them. No
% Pygments, no minted, and shell escape stays off (BO_0296_008).
\usepackage{fancyvrb}
$highlighting-macros$
\usepackage{listings}
\lstset{basicstyle=\ttfamily\footnotesize,breaklines=true}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,keepaspectratio}

\title{$title$}
\author{$for(author)$\IEEEauthorblockN{$author.name$}$if(author.affiliation)$\IEEEauthorblockA{$author.affiliation$$if(author.email)$\\$author.email$$endif$}$endif$$sep$ \and $endfor$}

\begin{document}
\maketitle
$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$
$if(keywords)$
\begin{IEEEkeywords}
$for(keywords)$$keywords$$sep$, $endfor$
\end{IEEEkeywords}
$endif$

$body$

$if(natbib)$
$if(bibliography)$
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$IEEEtran$endif$}
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$endif$
$if(supplementary)$
\clearpage
\appendices
\section*{Supplementary Material}
$supplementary$
$endif$
\end{document}
