{
  "name": "calliopa-shell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "prebuild": "node scripts/gen-registry.mjs",
    "build": "vite build && vite build -c adapters/node-server/vite.config.ts",
    "dev": "node scripts/serve.mjs --dev",
    "serve": "node scripts/serve.mjs",
    "pretypecheck": "node scripts/gen-registry.mjs",
    "typecheck": "tsc --noEmit",
    "precheck": "node scripts/gen-registry.mjs",
    "check": "vitest run --project unit --project behavior",
    "pretest:unit": "node scripts/gen-registry.mjs",
    "test:unit": "vitest run --project unit",
    "pretest:behavior": "node scripts/gen-registry.mjs",
    "test:behavior": "vitest run --project behavior",
    "verify:publish:website": "vitest run --project publish src/extensions/publishing/tests/publish/website.test.ts",
    "verify:publish:bunny-stream": "vitest run --project publish src/extensions/publishing/tests/publish/bunny-stream.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "node scripts/gen-registry.mjs"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "citeproc": "2.4.63",
    "csl-locales": "https://codeload.github.com/citation-style-language/locales/tar.gz/a89adece41013402236e2c9020972d7e931fbab8",
    "csl-styles": "https://codeload.github.com/citation-style-language/styles/tar.gz/8947960dc3c5133a873d77342c77c67300a2bc18"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@types/node": "22.10.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}
